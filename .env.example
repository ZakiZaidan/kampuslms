APP_NAME=KampusLMS
APP_ENV=production
# BUG 1 (w12): APP_KEY produksi sungguhan bocor di template publik!
# Seharusnya dikosongkan (APP_KEY=) agar di-generate manual saat setup server.
APP_KEY=base64:7vL9m2Qz4W8e1R3t5Y6u7I8o9P0a1S2d3F4g5H6j7K8=

# BUG 4 (w12): APP_DEBUG=true pada template produksi!
# Seharusnya APP_DEBUG=false agar layar Ignition tidak mengekspos kredensial ke publik saat error.
APP_DEBUG=true
APP_URL=https://kampuslms.demo.id

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# BUG 1 (lanjutan): Kredensial database produksi sungguhan bocor di file publik repo!
# Siapa pun di internet dapat melihat user dan password database produksi ini.
# Seharusnya diisi dummy atau dikosongkan (DB_PASSWORD=).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=campus_production
DB_USERNAME=admin_kampus
DB_PASSWORD=ProduksiRahasia2026!#db

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
